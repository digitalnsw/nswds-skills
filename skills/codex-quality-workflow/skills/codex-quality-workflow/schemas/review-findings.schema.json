{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/claude-code-quality-workflow/review-findings.schema.json",
  "title": "Evidence-backed code review findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["review", "completion", "findings", "coverage"],
  "properties": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "reviewer", "target"],
      "properties": {
        "base_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "head_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "reviewer": { "type": "string", "minLength": 1 },
        "target": { "enum": ["frozen-implementation", "repair-diff", "final-branch"] }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "remaining_scope", "continuation_notes"],
      "properties": {
        "status": { "enum": ["COMPLETE", "PARTIAL"] },
        "remaining_scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "continuation_notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "COMPLETE" } } },
          "then": {
            "properties": {
              "remaining_scope": { "maxItems": 0 },
              "continuation_notes": { "maxLength": 0 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "PARTIAL" } } },
          "then": {
            "properties": {
              "remaining_scope": { "minItems": 1 },
              "continuation_notes": { "minLength": 1 }
            }
          }
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passes_completed", "commands_run", "not_run", "clean_areas"],
      "properties": {
        "passes_completed": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 9 },
          "uniqueItems": true
        },
        "commands_run": { "type": "array", "items": { "type": "string" } },
        "not_run": { "type": "array", "items": { "type": "string" } },
        "clean_areas": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "severity", "confidence", "title", "locations", "contract",
        "trigger", "observed_behavior", "expected_behavior", "evidence", "evidence_sources",
        "consequence", "required_outcome", "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^R-[0-9]{3,}$" },
        "severity": { "enum": ["BLOCKING", "SHOULD_FIX", "WORTH_KNOWING"] },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "title": { "type": "string", "minLength": 1 },
        "locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/location" } },
        "contract": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "observed_behavior": { "type": "string", "minLength": 1 },
        "expected_behavior": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference"],
            "properties": {
              "kind": { "enum": ["code", "contract", "test", "validation", "static-analysis", "runtime", "history"] },
              "reference": { "type": "string", "minLength": 1 },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        },
        "consequence": { "type": "string", "minLength": 1 },
        "required_outcome": { "type": "string", "minLength": 1 },
        "status": { "enum": ["UNTRIAGED", "CONFIRMED", "REJECTED", "NEEDS_DECISION"] },
        "triage_reason": { "type": "string" },
        "decision_question": { "type": "string" },
        "decision_owner": { "type": "string" }
      }
    }
  }
}
