{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/claude-code-quality-workflow/review-evidence.schema.json",
  "title": "Prepared review evidence manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion", "createdAt", "target", "ready", "repository",
    "baseBranch", "baseSha", "headSha", "context", "validation",
    "analyzers", "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": { "enum": ["initial", "final"] },
    "ready": { "type": "boolean" },
    "reviewable": { "type": "boolean", "description": "Safe, configured initial evidence; does not imply gates passed." },
    "repositoryStateSafe": { "type": "boolean" },
    "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "headSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "analyzers": { "type": "array" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
