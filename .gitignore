# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# NOTE: this repo SHIPS .claude/, CLAUDE.md and AGENTS.md as skill content, so
# the fleet's canonical repo-files/.gitignore (which treats those as local AI
# tooling and ignores them at any depth) is deliberately NOT used verbatim here.

# dependencies
node_modules/

# Python bytecode from skill scripts
__pycache__/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# security scan output
snyk-analysis.json
snyk-code-analysis.json
